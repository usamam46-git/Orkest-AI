# infra/.env.prod.example — copy to infra/.env.prod on the server and fill in.
#
#   cp infra/.env.prod.example infra/.env.prod
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod up -d
#
# HOW THIS DIFFERS FROM .env.example
# ----------------------------------
# The development compose writes every secret as ${VAR:-committed-default}, so
# the stack boots on a fresh clone with no setup. docker-compose.prod.yml writes
# them as ${VAR:?message} instead: there are NO defaults, and the stack refuses
# to start until each one is set. That is deliberate. A production deployment
# that silently encrypts customer BYOK credentials under a key published in a
# public git history is worse than one that will not boot.
#
# Fill in every uncommented variable below. Anything left blank is a hard error
# from `docker compose`, naming the variable.

# --- Public identity -------------------------------------------------------
# The single origin the whole product is served from. nginx routes /api/v1/*
# to the API and everything else to the Next.js app on this one hostname, so
# there is no second CORS-exposed origin and the refresh cookie's
# SameSite=Strict is never fighting a cross-site request.
#
# No scheme, no trailing slash — nginx and certbot both take a bare hostname.
DOMAIN=

# Where Let's Encrypt sends expiry warnings. Use a real inbox you read.
ACME_EMAIL=

# The public origin WITH scheme. Read by the API as settings.FRONTEND_URL and
# used to build member invitation links (modules/organizations/router.py's
# _frontend_base_url). Its default is http://localhost:3000, so leaving this
# unset does not fail loudly — it silently mints invitation links pointing at
# localhost that no recipient can ever open.
#
#   FRONTEND_URL=https://${DOMAIN}
FRONTEND_URL=

# --- Application secrets ---------------------------------------------------
# Generate fresh values ON THE SERVER. Do not copy the development ones over,
# and do not reuse one value across all three — they are separate secrets.
#
#   SECRET_KEY / JWT_SECRET_KEY:  openssl rand -hex 32
SECRET_KEY=
JWT_SECRET_KEY=

# base64 of exactly 32 bytes. core/encryption.py b64decodes this and asserts
# len == 32 for AES-256-GCM, so a hex string or a passphrase fails at boot.
#
#   openssl rand -base64 32
#
# ROTATION IS DESTRUCTIVE, AND MORE SO HERE THAN IN DEVELOPMENT. Changing this
# makes every existing integrations.credentials blob, tools.secrets_encrypted
# map and workflows.webhook_secret_encrypted value permanently undecryptable —
# AES-GCM raises InvalidTag rather than returning garbage. In production that
# means: every customer re-enters their OpenAI key through Settings, every
# registry tool's API credentials are re-entered by hand, and every workflow
# webhook secret is regenerated and re-shared with whoever calls it.
#
# Back this value up somewhere your database backups are not, and treat losing
# it as equivalent to losing those rows.
INTEGRATION_ENCRYPTION_KEY=

# --- Cost controls ---------------------------------------------------------
# Per-org daily cap on workflow runs, enforced in Redis before the Celery
# enqueue on all three trigger paths. 0 disables it entirely.
DAILY_RUN_QUOTA_PER_ORG=1000

# --- OpenAI ----------------------------------------------------------------
# Optional, and usually SHOULD be empty in production. BYOK through the
# Settings page is the intended path: it is resolved per-organization at
# execution time and bills each org to its own account.
#
# A value here is the server-wide fallback for any org with no stored key. That
# is a real and unbounded spend on your own account — set it only if you intend
# to absorb that, and keep DAILY_RUN_QUOTA_PER_ORG meaningful if you do.
OPENAI_API_KEY=

# --- Error reporting -----------------------------------------------------------
# Optional. Empty means no error reporting at all: Sentry is initialised only
# when a DSN is present (src/core/observability.py). Errors then exist solely in
# `dc logs`.
SENTRY_DSN=

# --- Backups (infra/backup.sh) --------------------------------------------------
# Destination for the nightly pg_dump, e.g. s3://my-orkest-backups/db/
# The instance needs an IAM role allowing s3:PutObject on that prefix (see
# DEPLOY-AWS.md section 10). Do NOT put this file, or INTEGRATION_ENCRYPTION_KEY,
# in that bucket: a backup that carries its own decryption key protects nothing.
BACKUP_S3_URI=
# Optional dead-man's switch (e.g. a healthchecks.io ping URL). Requested only
# after a backup uploaded and verified, so silence means the backup did not run.
BACKUP_PING_URL=

# --- Infrastructure credentials --------------------------------------------
# Read by the postgres container on FIRST BOOT ONLY, then baked into
# their volumes. Changing them later without also destroying those volumes
# produces authentication failures, not improved security. Set them now.
#
#   openssl rand -hex 24
POSTGRES_USER=aap_user
POSTGRES_PASSWORD=
POSTGRES_DB=aap_db

# --- Object storage (AWS S3) -------------------------------------------------
# Knowledge-base uploads go to S3, authenticated by the EC2 instance's IAM role —
# there are no storage keys to set, by design. (MinIO is for local development
# only; it no longer publishes images.) infra/aws-provision.sh creates the bucket
# and the role; its final output prints both values.
S3_DOCUMENTS_BUCKET=
AWS_REGION=us-east-1

# --- Contact form ----------------------------------------------------------
# The marketing contact endpoint (app/api/contact/route.ts) returns 503 until
# this is set, deliberately — a form that says "thanks, we'll be in touch"
# while dropping the submission loses real leads and nobody notices.
# A Slack incoming webhook, a Zapier catch hook, or any URL taking a JSON POST.
#
# Server-side only. Never rename this to NEXT_PUBLIC_*.
CONTACT_WEBHOOK_URL=

# --- Optional observability ------------------------------------------------
# LANGSMITH_API_KEY=
# SENTRY_DSN=
